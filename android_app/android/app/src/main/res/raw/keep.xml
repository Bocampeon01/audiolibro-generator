<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service busca sus iconos de notificacion por nombre en runtime; sin esto el
     resource shrinking del build release los borra y la notificacion/sesion multimedia
     falla ("You must specify an icon resource id to build a CustomAction"). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@mipmap/ic_launcher" />
